# personal | family
STEPVIEW_MODE=personal

# local gateway implementation
STEPVIEW_GATEWAY=local

# Optional. Defaults to Electron userData
STEPVIEW_DATA_DIR=

# LLM defaults
STEPVIEW_LLM_PROVIDER=openai
STEPVIEW_OPENAI_BASE_URL=https://api.openai.com/v1
STEPVIEW_OPENAI_MODEL=gpt-5.1

# family mode options
STEPVIEW_ALLOW_REGISTRATION=true
STEPVIEW_SESSION_TTL_HOURS=168

# Cross-origin allowlist (comma separated). Leave empty unless the frontend is
# served from a different origin than the gateway; empty means no CORS headers
# are sent at all. Wildcards are rejected.
STEPVIEW_ALLOWED_ORIGINS=

# Encrypts the API keys stored in each account database (AES-256-GCM).
# Leave empty and the gateway generates dataDir/secret.key (0600) on demand --
# convenient locally, but then the key travels with any data-directory backup.
# Set it in production: openssl rand -hex 32
STEPVIEW_SECRET_KEY=
