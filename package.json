{
    "name": "stepview",
    "version": "1.0.0",
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "vite build --base ./",
        "preview": "vite preview --host 0.0.0.0",
        "test": "vitest run --pool=threads",
        "preflight": "node scripts/preflight.js",
        "preflight:desktop": "node scripts/preflight.js --mode=personal",
        "preflight:family": "node scripts/run-family-docker.js --check",
        "desktop": "node scripts/run-stepview.js --mode=personal",
        "family": "node scripts/run-family-docker.js",
        "family:stop": "docker compose stop",
        "family:down": "docker compose down",
        "family:logs": "docker compose logs -f",
        "start:desktop": "npm-run-all -p dev electron:wait",
        "start:family": "cross-env STEPVIEW_MODE=family npm-run-all -p dev family:server",
        "family:server": "node electron/familyServer.js",
        "electron:wait": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.js",
        "desktop:prod": "npm run build && electron electron/main.js",
        "dist:win": "npm run build && electron-builder --win dir"
    },
    "build": {
        "appId": "com.stepview.app",
        "productName": "StepView",
        "directories": {
            "output": "release"
        },
        "electronDist": "node_modules/electron/dist",
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "win": {
            "signAndEditExecutable": false,
            "target": [
                "dir"
            ]
        }
    },
    "dependencies": {
        "@vitejs/plugin-react": "latest",
        "cross-env": "latest",
        "katex": "^0.18.4",
        "npm-run-all": "latest",
        "react": "latest",
        "react-dom": "latest",
        "react-markdown": "^10.1.0",
        "rehype-katex": "^7.0.1",
        "remark-math": "^6.0.0",
        "vite": "latest",
        "vitest": "latest",
        "wait-on": "latest"
    },
    "devDependencies": {
        "electron": "^42.1.0",
        "electron-builder": "^26.8.1"
    }
}
